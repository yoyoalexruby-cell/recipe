        "name": "老姜片",
        "amount": 5,
        "unit": "厚片",
        "category": "seasoning",
        "note": "拍松散发姜油"
      },
      {
        "id": "i7",
        "name": "京葱葱白段",
        "amount": 3,
        "unit": "段",
        "category": "seasoning",
        "note": "约手指长"
      },
      {
        "id": "i8",
        "name": "八角（大茴香）",
        "amount": 2,
        "unit": "枚",
        "category": "seasoning",
        "note": "不可贪多，以免药味重"
      },
      {
